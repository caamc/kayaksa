  "elevation": {
    "light": {
      "e0": "0 0 0 1px #D4DEE2",
      "e1": "0 1px 2px rgba(14,47,60,.08)",
      "e2": "0 6px 16px rgba(14,47,60,.10)",
      "e3": "0 16px 40px rgba(14,47,60,.18)"
    },
    "dark": {
      "e0": "0 0 0 1px rgba(212,222,226,.15)",
      "e1": "0 0 0 1px rgba(212,222,226,.10),0 1px 2px rgba(0,0,0,.30)",
      "e2": "0 0 0 1px rgba(212,222,226,.10),0 6px 16px rgba(0,0,0,.35)",
      "e3": "0 0 0 1px rgba(212,222,226,.10),0 16px 40px rgba(0,0,0,.45)"
    }
  },
  "motion": {
    "micro": {
      "$type": "transition",
      "$value": {
        "duration": "120ms",
        "timingFunction": "ease-out"
      }
    },
    "standard": {
      "$type": "transition",
      "$value": {
        "duration": "200ms",
        "timingFunction": "cubic-bezier(.2,0,0,1)"
      }
    },
    "paddle": {
      "$type": "transition",
      "$value": {
        "duration": "320ms",
        "timingFunction": "cubic-bezier(.3,0,0,1)"
      }
    },
    "page": {
      "$type": "transition",
      "$value": {
        "duration": "480ms",
        "timingFunction": "cubic-bezier(.2,0,0,1)"
      }
    }
  },
