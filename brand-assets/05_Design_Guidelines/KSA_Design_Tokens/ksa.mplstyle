# Kayak Strategic Advisors - matplotlib style. Use: plt.style.use('ksa.mplstyle')
font.family: Archivo, Arial, sans-serif
font.size: 10
axes.prop_cycle: cycler('color', ['17807E', '2D6A9F', '4B7A4E', '3E5563', 'D8C5A1', '5E4B78', '5DB2AB', '9AAD5A'])
axes.edgecolor: 8B9A9C
axes.labelcolor: 3E5563
axes.titlesize: 13
axes.titleweight: bold
axes.titlelocation: left
axes.titlecolor: 0E2F3C
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.grid: True
axes.grid.axis: y
grid.color: D4DEE2
grid.linewidth: 1
lines.linewidth: 2
xtick.color: 3E5563
ytick.color: 3E5563
ytick.left: False
xtick.major.size: 0
legend.frameon: False
figure.facecolor: FFFFFF
savefig.dpi: 300
savefig.bbox: tight
