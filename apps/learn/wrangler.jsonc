{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kayaksa-learn",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "learn.kayaksa.com", "custom_domain": true }],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "kayaksa-learn", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": false }],
  "observability": { "enabled": true },
  "vars": {
    "SITE_URL": "https://learn.kayaksa.com",
    "MAIL_FROM": "Kayak Learn <learn@kayaksa.com>"
  }
  // Optional secret: RESEND_API_KEY (email verification and password resets).
}
