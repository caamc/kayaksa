{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "kayaksa-meet",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "meet.kayaksa.com", "custom_domain": true }],
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "kayaksa-meet", "database_id": "00000000-0000-0000-0000-000000000003", "migrations_dir": "migrations" }],
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "SPACES", "class_name": "Space" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Space"] }],
  "r2_buckets": [{ "binding": "REC", "bucket_name": "kayaksa-meet" }],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
  // Secrets: MEET_SIGNING_KEY (shared with internal). Optional: TURN_KEY_ID, TURN_KEY_API_TOKEN.
}
